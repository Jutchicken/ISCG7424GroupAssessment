<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="#E0E0E0"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tv_bookingCustomer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Customer: John"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tv_bookingDateTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="-20/10/2020 18:30"/>

        <TextView
            android:id="@+id/tv_bookingGuests"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Guests: 4"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tv_bookingTable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Table: Not assigned yet"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tv_bookingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: Pending"
            android:textSize="14sp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_assignBooking"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Assign Here"/>

            <Button
                android:id="@+id/btn_confirmBooking"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confirm"/>

            <Button
                android:id="@+id/btn_cancelBooking"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Cancel"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>