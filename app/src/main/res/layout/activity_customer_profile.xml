<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".customer.C_Profile">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

       <LinearLayout
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:orientation="horizontal">

           <Button
               android:onClick="btnCBack"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:text="Back"/>

           <Button
               android:onClick="btnCLogout"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:text="Logout"/>

       </LinearLayout>



        <!-- All Dummy Data -->
        <TextView
            android:id="@+id/tv_customerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:gravity="center"
            android:text="John Smith"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_customerEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="john@email.com"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Personal Information"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Name"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_customerName2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="John Smith"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Email"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_customerEmail2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="john@email.com"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Phone"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_customerPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="021 123 4567"
            android:textSize="16sp" />


    </LinearLayout>

</ScrollView>