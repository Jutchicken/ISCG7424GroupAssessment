<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".customer.C_BookingRequest"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Book which date?"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btn_customerBookingBack"
            android:layout_marginStart="70dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back"/>

    </LinearLayout>


    <DatePicker
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:id="@+id/datePicker"
        >

    </DatePicker>

    <TimePicker
        android:id="@+id/tpCustomer"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:timePickerMode="spinner"
        >

    </TimePicker>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="For how many?"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>


    <NumberPicker
        android:id="@+id/npCustomer"
        android:layout_width="match_parent"
        android:layout_height="50dp">

    </NumberPicker>

    <Button
        android:id="@+id/btn_customerBook"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Book"/>


</LinearLayout>